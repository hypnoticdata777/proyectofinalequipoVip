{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://REEMPLAZA-CON-TU-URL.up.railway.app/api/:path*"
    },
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    }
  ],
  "buildCommand": "npm run build -- --configuration production",
  "outputDirectory": "dist/usf-portal-frontend/browser"
}
