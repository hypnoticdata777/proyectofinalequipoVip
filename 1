Este es el módulo más pesado. Se divide en 3 sub-features:
Sub-feature A: Inscripción de Materias
La lógica de validación (RF-15) es la más crítica. Antes de confirmar la inscripción, el backend debe correr estas 4 validaciones en secuencia:
javascript// services/inscripcion.service.js
async function validarInscripcion(alumnoId, materiasIds) {
  
  // 1. Verificar que no tenga adeudos financieros (CP-05)
  const adeudos = await Pago.find({ alumno_id: alumnoId, estado: "pendiente" });
  if (adeudos.length > 0) throw new Error("ADEUDO_FINANCIERO");

  // 2. Verificar cupo disponible
  for (const id of materiasIds) {
    const materia = await Materia.findById(id);
    if (materia.cupoDisponible <= 0) throw new Error(`SIN_CUPO: ${materia.nombre}`);
  }

  // 3. Verificar seriación (prerequisitos)
  const historial = await Calificacion.find({ alumno_id: alumnoId, aprobada: true });
  for (const id of materiasIds) {
    const materia = await Materia.findById(id).populate("seriacion");
    const prerequisitosAprobados = materia.seriacion.every(pre =>
      historial.some(h => h.materia_id.equals(pre._id))
    );
    if (!prerequisitosAprobados) throw new Error(`SERIACION_INCOMPLETA: ${materia.nombre}`);
  }

  // 4. Verificar choques de horario (CP-06)
  const materias = await Materia.find({ _id: { $in: materiasIds } });
  // Comparar cada par de horarios para detectar traslapes
  for (let i = 0; i < materias.length; i++) {
    for (let j = i + 1; j < materias.length; j++) {
      if (tienenCruceDeHorario(materias[i].horario, materias[j].horario)) {
        throw new Error(`CRUCE_HORARIO: ${materias[i].nombre} con ${materias[j].nombre}`);
      }
    }
  }

  return true; // Todo OK → proceder
}
Sub-feature B: Captura de Calificaciones
Lógica importante: una vez que el admin cierra el periodo, las notas deben quedar bloqueadas (CP-07). El campo cerrada: Boolean en el schema lo maneja:
javascript// Middleware que bloquea edición si el acta está cerrada
async function protegerActaCerrada(req, res, next) {
  const calificacion = await Calificacion.findById(req.params.id);
  if (calificacion.cerrada) {
    return res.status(403).json({ error: "El acta ya fue cerrada por administración" });
  }
  next();
}
